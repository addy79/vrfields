class_name ParametricTopic
extends Topic
## Parametric surfaces r(u, v) generated by the compute shader, coloured by
## Gaussian curvature K (also computed on the GPU from the fundamental forms).
## A point (u, v) shows the tangent vectors r_u, r_v, the normal, K and the mean
## curvature H. Parameters a, b and time t can morph the surface live.
## Typed input: "(x(u,v), y(u,v), z(u,v)), u = 0..2pi, v = 0..pi".

const EXTENT := 2.0
const RESOLUTION := [48, 96, 160, 256]
const COLOR_MODES: PackedStringArray = ["Gaussian curvature K", "u-v checkerboard", "Normal direction"]
const PRESETS: Array[Dictionary] = [
	{"name": "Sphere", "text": "(a sin(u) cos(v), a sin(u) sin(v), a cos(u)), u = 0..pi, v = 0..2pi", "a": 1.5,
		"note": "Radius a: K = 1/a² > 0 everywhere (red): the sphere curves the same way in every direction."},
	{"name": "Torus", "text": "((2 + a cos(v)) cos(u), (2 + a cos(v)) sin(u), a sin(v)), u = 0..2pi, v = 0..2pi", "a": 0.7,
		"note": "Outer half K > 0 (red, like a sphere), inner half K < 0 (blue, like a saddle),\nK = 0 on the top and bottom circles. ∫∫ K dA = 0 for any torus (Gauss–Bonnet)."},
	{"name": "Saddle (hyperbolic paraboloid)", "text": "(u, v, a (u^2 - v^2) / 2), u = -1.5..1.5, v = -1.5..1.5", "a": 1.0,
		"note": "K < 0 everywhere (blue): the surface bends up along u and down along v."},
	{"name": "Möbius strip", "text": "((2 + v cos(u / 2)) cos(u), (2 + v cos(u / 2)) sin(u), v sin(u / 2)), u = 0..2pi, v = -0.6..0.6", "a": 1.0,
		"note": "One-sided: follow the tinted back side around once and you are on the front.\nThe normal flips sign after one loop, so the surface is not orientable."},
	{"name": "Helicoid", "text": "(v cos(u), v sin(u), a u / 2), u = -2pi..2pi, v = -1.5..1.5", "a": 1.0,
		"note": "A minimal surface: mean curvature H = 0 (soap film). K ≤ 0 everywhere."},
	{"name": "Enneper surface", "text": "(u - u^3/3 + u v^2, v - v^3/3 + v u^2, u^2 - v^2) / 2, u = -1.5..1.5, v = -1.5..1.5", "a": 1.0,
		"note": "Another minimal surface (H = 0) that intersects itself for larger (u, v)."},
	{"name": "Klein bottle (figure 8)", "text": "((2 + cos(u/2) sin(v) - sin(u/2) sin(2v)) cos(u), (2 + cos(u/2) sin(v) - sin(u/2) sin(2v)) sin(u), sin(u/2) sin(v) + cos(u/2) sin(2v)), u = 0..2pi, v = 0..2pi", "a": 1.0,
		"note": "A closed surface with no inside: it cannot sit in 3D without crossing itself."},
	{"name": "Dini's surface", "text": "(cos(u) sin(v), sin(u) sin(v), cos(v) + ln(tan(v / 2)) + a u / 5), u = 0..4pi, v = 0.1..2", "a": 1.0,
		"note": "A twisted pseudosphere: constant negative curvature K = −1/(1 + (a/5)²) (uniform blue)."},
	{"name": "Breathing torus (t)", "text": "((2 + (0.6 + 0.3 sin(t)) cos(v)) cos(u), (2 + (0.6 + 0.3 sin(t)) cos(v)) sin(u), (0.6 + 0.3 sin(t)) sin(v)), u = 0..2pi, v = 0..2pi", "a": 1.0,
		"note": "The tube radius changes with time; the curvature colours follow live (GPU, every frame)."},
]

var engine := ParametricEngine.new()
var color_mode := 0
var show_frame := true
## The probe point as fractions of the u and v ranges.
var probe_uv := Vector2(0.35, 0.3)
var fit_scale := 1.0

var _surface := MeshInstance3D.new()
var _surface_mat := Topic.shader_material("res://shaders/param_surface.gdshader")
var _point := MeshInstance3D.new()
var _ru := MeshUtil.make_arrow(Color(1.0, 0.4, 0.35), 0.022)
var _rv := MeshUtil.make_arrow(Color(0.4, 1.0, 0.45), 0.022)
var _normal := MeshUtil.make_arrow(Color(0.45, 0.6, 1.0), 0.022)
var _probe_label := MeshUtil.label("", 34)
var _frame_cache := {}


func _init() -> void:
	topic_title = "Parametric Surfaces"


func engines() -> Array[FieldEngine]:
	return [engine]


func presets() -> Array[Dictionary]:
	return PRESETS


func _build() -> void:
	plot.add_child(Topic.make_box_and_axes(EXTENT))
	_surface.material_override = _surface_mat
	_surface.custom_aabb = AABB(Vector3.ONE * -EXTENT * 1.6, Vector3.ONE * EXTENT * 3.2)
	plot.add_child(_surface)
	var dot := SphereMesh.new()
	dot.radius = 0.06
	dot.height = 0.12
	dot.material = MeshUtil.flat_material(Color.WHITE)
	_point.mesh = dot
	plot.add_child(_point)
	for n: Node3D in [_ru, _rv, _normal]:
		plot.add_child(n)
	_probe_label.pixel_size = 0.0035
	_probe_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_LEFT
	plot.add_child(_probe_label)


func apply_quality() -> void:
	engine.resolution = RESOLUTION[quality]
	_surface.mesh = MeshUtil.grid_mesh(engine.resolution)
	_surface_mat.set_shader_parameter("resolution", engine.resolution)
	engine.dirty = true


func _apply_preset(index: int) -> void:
	var p: Dictionary = PRESETS[index]
	set_params(p.a, engine.param_b)
	control_value_changed.emit("a", p.a)
	set_function(p.text)
	function_text_changed.emit(p.text)


## Parses "(x, y, z), u = 0..2pi, v = -1..1" (ranges optional, default 0..2π).
static func parse_input(text: String) -> Dictionary:
	var ranges := {"u": Vector2(0.0, TAU), "v": Vector2(0.0, TAU)}
	var body := text
	var top := _top_level_split(text)
	if top.size() > 1:
		var tuple_parts := PackedStringArray()
		for piece in top:
			var eq := piece.find("=")
			if eq > 0 and piece.substr(0, eq).strip_edges() in ["u", "v"]:
				var name := piece.substr(0, eq).strip_edges()
				var bounds := piece.substr(eq + 1).split("..")
				if bounds.size() != 2:
					return {"error": "Write ranges like %s = 0..2pi" % name}
				var lo := MathExpr.compile(bounds[0], PackedStringArray())
				var hi := MathExpr.compile(bounds[1], PackedStringArray())
				if not lo.is_valid() or not hi.is_valid():
					return {"error": "Range of %s: %s" % [name, lo.error if not lo.is_valid() else hi.error]}
				ranges[name] = Vector2(lo.evaluate([]), hi.evaluate([]))
			else:
				tuple_parts.append(piece)
		body = ", ".join(tuple_parts)
	return {"error": "", "body": body, "u": ranges.u, "v": ranges.v}


## Splits at commas outside brackets.
static func _top_level_split(text: String) -> PackedStringArray:
	var out := PackedStringArray()
	var depth := 0
	var start := 0
	for i in text.length():
		var c := text[i]
		if c == "(":
			depth += 1
		elif c == ")":
			depth -= 1
		elif c == "," and depth == 0:
			out.append(text.substr(start, i - start).strip_edges())
			start = i + 1
	out.append(text.substr(start).strip_edges())
	return out


func set_function(text: String) -> String:
	var parsed := parse_input(text)
	if not parsed.error.is_empty():
		return parsed.error
	var body: String = parsed.body
	# "(...)/2": a whole tuple divided by a number.
	var scale_suffix := ""
	var close := body.rfind(")")
	if body.begins_with("(") and close > 0 and close < body.length() - 1:
		scale_suffix = body.substr(close + 1).strip_edges()
		var inner := body.substr(1, close - 1)
		var comps := MathExpr.split_tuple(inner)
		if comps.size() == 3 and scale_suffix.begins_with("/"):
			body = "(%s)" % ", ".join(PackedStringArray([
					"(%s)%s" % [comps[0], scale_suffix], "(%s)%s" % [comps[1], scale_suffix],
					"(%s)%s" % [comps[2], scale_suffix]]))
	var u: Vector2 = parsed.u
	var v: Vector2 = parsed.v
	var error := engine.set_surface(body, u.x, u.y, v.x, v.y)
	if error.is_empty():
		engine.text = text.strip_edges()
		_fit()
	return error


## Scales the surface into the box from a CPU sample (41 × 41).
func _fit() -> void:
	var top := 1e-6
	for j in 41:
		for i in 41:
			var p := engine.r(lerpf(engine.u_range.x, engine.u_range.y, i / 40.0),
					lerpf(engine.v_range.x, engine.v_range.y, j / 40.0))
			top = maxf(top, maxf(absf(p.x), maxf(absf(p.y), absf(p.z))))
	fit_scale = minf(1.0, EXTENT * 0.95 / top)
	_surface_mat.set_shader_parameter("fit_scale", fit_scale)
	_update_probe()


func get_function_spec() -> Dictionary:
	return {"label": "r(u, v) =", "text": engine.text, "variables": PackedStringArray(ParametricEngine.VARIABLES),
			"help": "(x, y, z), u = 0..2pi, v = 0..pi   (ranges optional; t, a, b allowed)"}


func get_controls() -> Array:
	return [
		ControlSpec.choice("preset", "Surface", preset_names(), _preset_index),
		ControlSpec.slider("a", "a", -3.0, 3.0, 0.05, engine.param_a),
		ControlSpec.slider("b", "b", -3.0, 3.0, 0.05, engine.param_b),
		ControlSpec.choice("color", "Colour", COLOR_MODES, color_mode),
		ControlSpec.slider("u", "Point u", 0.0, 1.0, 0.01, probe_uv.x),
		ControlSpec.slider("v", "Point v", 0.0, 1.0, 0.01, probe_uv.y),
		ControlSpec.toggle("frame", "Tangents r_u, r_v and normal", show_frame),
	]


func on_control(id: String, value: Variant) -> void:
	match id:
		"preset":
			select_preset(value)
		"a":
			set_params(value, engine.param_b)
			_fit()
		"b":
			set_params(engine.param_a, value)
			_fit()
		"color":
			color_mode = value
		"u":
			probe_uv.x = value
			_update_probe()
		"v":
			probe_uv.y = value
			_update_probe()
		"frame":
			show_frame = value
			_update_probe()


func handle_nudge(axis: Vector2, delta: float) -> void:
	probe_uv = (probe_uv + axis * 0.3 * delta).clamp(Vector2.ZERO, Vector2.ONE)
	control_value_changed.emit("u", snappedf(probe_uv.x, 0.01))
	control_value_changed.emit("v", snappedf(probe_uv.y, 0.01))
	_update_probe()


func handle_action() -> void:
	color_mode = (color_mode + 1) % COLOR_MODES.size()
	control_value_changed.emit("color", color_mode)


func get_hint() -> String:
	return "Arrow keys move the point (u, v); Space changes the colouring.\n" \
			+ "Red = positive Gaussian curvature, blue = negative, white = flat."


func probe_frame() -> Dictionary:
	var u := lerpf(engine.u_range.x, engine.u_range.y, probe_uv.x)
	var v := lerpf(engine.v_range.x, engine.v_range.y, probe_uv.y)
	var fr := engine.frame(u, v)
	fr["u"] = u
	fr["v"] = v
	return fr


func _update_probe() -> void:
	if engine.exprs.is_empty():
		return
	var fr := probe_frame()
	_frame_cache = fr
	var p := MeshUtil.to_godot(fr.point * fit_scale)
	_point.position = p
	for n: Node3D in [_ru, _rv, _normal]:
		n.position = p
	var ru: Vector3 = fr.r_u
	var rv: Vector3 = fr.r_v
	var len_ref := maxf(ru.length(), rv.length())
	var s := 0.8 / maxf(len_ref, 1e-6)
	MeshUtil.set_arrow(_ru, MeshUtil.to_godot(ru * s) if show_frame else Vector3.ZERO)
	MeshUtil.set_arrow(_rv, MeshUtil.to_godot(rv * s) if show_frame else Vector3.ZERO)
	MeshUtil.set_arrow(_normal, MeshUtil.to_godot(fr.normal * 0.8) if show_frame else Vector3.ZERO)
	_probe_label.position = p + Vector3(0.25, 0.3, 0.0)
	_probe_label.text = "(u, v) = (%.2f, %.2f)\nK = %.3f   H = %.3f\n|r_u × r_v| = %.3f" % [
			fr.u, fr.v, fr.K, fr.H, ru.cross(rv).length()]


func _update_topic(_delta: float) -> void:
	_surface_mat.set_shader_parameter("color_mode", color_mode)
	if engine.is_time_dependent():
		_update_probe()


func _bind_outputs() -> void:
	Topic.bind_texture(_surface_mat, "surface_tex", engine.get_output("surface"))
	Topic.bind_texture(_surface_mat, "stats_tex", engine.get_output("stats"))


func _make_readout() -> String:
	return "r(u, v) = %s\nDrawn at ×%.2f.  max |K| on the grid = %.2f\n\n%s" % [
			engine.text, fit_scale, engine.max_curvature, explanation()]


func workload() -> Dictionary:
	return {"surface points (with K)": engine.resolution ** 2}


func get_debug_state() -> Dictionary:
	return {"probe": _frame_cache, "resolution": engine.resolution, "fit": fit_scale,
			"u_range": engine.u_range, "v_range": engine.v_range}
